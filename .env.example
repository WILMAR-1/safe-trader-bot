# ===================================
# SafeTraderBot - Configuracion
# ===================================
# Copia este archivo a .env y sustituye los valores de ejemplo por los tuyos.
# NUNCA pongas credenciales reales en este archivo (.env.example SI se sube a git).

# ===================================
#  BROKER ACTIVO
# ===================================
# binance = cripto spot (CCXT)  |  exness = CFD/forex con apalancamiento (MetaTrader 5)
BROKER=binance

# ===================================
#  BINANCE (cripto spot, sin apalancamiento)
# ===================================
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=TU_API_KEY_DE_BINANCE_AQUI
EXCHANGE_API_SECRET=TU_API_SECRET_DE_BINANCE_AQUI
EXCHANGE_PASSWORD=

# ===================================
#  EXNESS (MetaTrader 5) - CON APALANCAMIENTO
# ===================================
# Estos datos salen del Area Personal de Exness al crear una cuenta MT5.
# EMPIEZA SIEMPRE CON UNA CUENTA DEMO (dinero virtual).
EXNESS_LOGIN=12345678
EXNESS_PASSWORD=TU_PASSWORD_DE_TRADING_MT5
# Servidor: Exness-MT5Trial (demo) | Exness-MT5Real (real). El nombre exacto sale en tu Area Personal.
EXNESS_SERVER=Exness-MT5Trial
# Ruta a la terminal MT5 (solo Windows). Vacio = autodetectar.
MT5_TERMINAL_PATH=
# Simbolos de Exness (ojo: se llaman distinto que en Binance, sin barra)
EXNESS_SYMBOLS=BTCUSD,XRPUSD,ETHUSD

# --- Reglas de apalancamiento y riesgo (SOLO aplican a Exness) ---
# Apalancamiento maximo permitido por el bot (aunque el broker ofrezca mas)
MAX_LEVERAGE=3
# % del capital que se arriesga por operacion (regla del 1%).
# Tambien lo usa STRATEGY=trend en Binance para dimensionar por volatilidad.
RISK_PER_TRADE_PCT=1.0
# Margen libre minimo que debe quedar; por debajo el bot NO abre posiciones
MIN_FREE_MARGIN_PCT=50
# Perdida maxima diaria; al alcanzarla el bot se pausa
MAX_DAILY_LOSS_PCT=3.0

# ===================================
#  TRADING
# ===================================
# Modo: dry_run (simulacion, SIN dinero real) | live (dinero real)
TRADING_MODE=dry_run

# Estrategia: safe (original) | trend (seguimiento de tendencia, ver README)
# Con trend usa TIMEFRAME=1h o 4h: en 5m las comisiones se comen la ventaja.
STRATEGY=safe

STAKE_CURRENCY=USDT
STAKE_AMOUNT=50
MAX_OPEN_TRADES=3
TIMEFRAME=5m

# Pares a operar (separados por coma) - formato Binance
PAIR_WHITELIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT

# ===================================
#  GESTION DE RIESGO (general)
# ===================================
MAX_DRAWDOWN_PERCENT=10
STOPLOSS=-0.03
TRAILING_STOP=true
TRAILING_STOP_POSITIVE=0.01
TRAILING_STOP_ACTIVATION=0.02

# --- Solo STRATEGY=trend (valores por defecto de las Tortugas / CTA) ---
TREND_ENTRY_N=55
TREND_EXIT_N=20
TREND_MOMENTUM_N=90
TREND_STOP_ATR=2.0
TREND_TRAIL_ATR=3.0
# Minutos sin reentrar en un par tras cerrarlo
COOLDOWN_MINUTES=60
# Nº de stops en 24h que bloquean todas las entradas 12h (0 = desactivado)
STOPLOSS_GUARD_COUNT=3

# ===================================
#  TELEGRAM (opcional)
# ===================================
# Token: creas un bot con @BotFather en Telegram y te lo da.
# Chat ID: se lo pides a @userinfobot.
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ===================================
#  BASE DE DATOS Y LOGS
# ===================================
DB_PATH=data/trades.db
LOG_LEVEL=INFO
